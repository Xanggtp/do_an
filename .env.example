PORT=5000
DATABASE_URL="mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/account_dashboard"
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Storage: 'local' or 's3'
UPLOAD_PROVIDER=local
UPLOAD_DIRECTORY=./uploads
MAX_VIDEO_BYTES=2147483648

# Worker mode: 'stub' (fake AI, no Redis), 'inline' (real pipeline inside API), 'queue' (BullMQ + Redis)
WORKER_MODE=stub
REDIS_URL=redis://127.0.0.1:6379

# Lecture segmentation
SEGMENT_SECONDS=120

# Google Gemini (leave GEMINI_API_KEY empty to use the deterministic stub analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Teachers can also save their own key in Settings; it is encrypted with this value (defaults to JWT_SECRET).
# Changing it (or JWT_SECRET when this is empty) means teachers must re-enter their key.
# SETTINGS_ENCRYPTION_KEY=

# Rate limits: requests per IP per 15 minutes (RATE_LIMIT_ENABLED=false turns them off)
AUTH_RATE_LIMIT=20
RECOVERY_RATE_LIMIT=10
# Set to 1 when running behind a reverse proxy (Nginx, Render, ...) so limits use the real client IP
# TRUST_PROXY=1

# Optional: override bundled ffmpeg / ffprobe binaries
# FFMPEG_PATH=
# FFPROBE_PATH=

# Required only when UPLOAD_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
