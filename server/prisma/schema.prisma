generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoStage {
  UPLOADED
  VALIDATING
  SEGMENTING
  ANALYZING
  COMPLETED
  FAILED
}

enum FeedbackCategory {
  STRENGTH
  GROWTH_OPPORTUNITY
}

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  name               String
  bio                String   @default("")
  passwordHash       String
  securityQuestion   String
  securityAnswerHash String
  /// Incremented on password change/reset so older JWTs stop working. Optional so existing users need no migration.
  tokenVersion       Int?     @default(0)
  /// Teacher's own Gemini API key, AES-256-GCM encrypted (utils/secretBox.js). Never sent to the client.
  geminiApiKeyEnc    String?
  /// Last 4 characters of the key, shown in Settings so the user can recognise it.
  geminiKeyHint      String?
  geminiModel        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  teacher            Teacher?

  @@index([createdAt])
}

model Teacher {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes   Class[]
  semesters Semester[]
}

model Semester {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String
  teacherId String   @db.ObjectId
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classes   Class[]

  @@unique([teacherId, code])
  @@index([teacherId, createdAt])
}

model Class {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  classCode      String?
  subject        String
  semester       String
  semesterId     String?   @db.ObjectId
  teacherId      String    @db.ObjectId
  createdAt      DateTime  @default(now())
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  semesterRecord Semester? @relation(fields: [semesterId], references: [id])
  videos         Video[]

  @@unique([teacherId, semester, name])
  @@index([teacherId, createdAt])
}

model Video {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  filename    String
  fileUrl     String
  duration    Float?
  status      VideoStatus    @default(PENDING)
  stage       VideoStage     @default(UPLOADED)
  progress    Int            @default(0)
  sizeBytes   Float?
  resolution  String?
  videoCodec  String?
  classId     String         @db.ObjectId
  createdAt   DateTime       @default(now())
  processedAt DateTime?
  error       String?
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  feedback    Feedback[]
  analytics   Analytics?
  segments    VideoSegment[]

  @@index([classId, createdAt])
  @@index([status, createdAt])
}

model Feedback {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  videoId         String           @db.ObjectId
  timestamp       Float
  category        FeedbackCategory
  rubricDimension String
  title           String
  description     String
  video           Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, timestamp])
}

model Analytics {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  videoId            String @unique @db.ObjectId
  copusTimeline      Json
  bloomsDistribution Json
  video              Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model VideoSegment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  videoId    String   @db.ObjectId
  index      Int
  startSec   Float
  endSec     Float
  storageKey String
  review     Json?
  createdAt  DateTime @default(now())
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, index])
}
